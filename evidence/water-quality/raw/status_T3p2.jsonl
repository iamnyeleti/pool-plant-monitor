<body class='login'>
	<header>
		<div>
			<a href="#">
				<img src="./assets/Images/mylogo.png" alt="logo" class="logo">
			</a>
		</div>
	</header>
	
	<form name="sendin" action="http://log.in/login" method="post">
		<input type="hidden" name="username" />
		<input type="hidden" name="password" />
		<input type="hidden" name="dst" value="http://192.168.4.1/api/status" />
		<input type="hidden" name="popup" value="true" />
	</form>

	<script type="text/javascript" src="md5.js"></script>
	<script type="text/javascript">
		<!--
		function doLogin() {
			document.sendin.username.value = document.login.username.value;
			document.sendin.password.value = hexMD5('\331' + document.login.password.value + '\003\047\357\332\236\235\343\152\330\202\332\171\376\235\245\345');
			document.sendin.submit();
			return false;
		}
		//
		-->
	</script>
		<main class="d-flex justify-content-center align-item-center flex-column">
		<div class="form d-flex flex-column align-item-center">
			<h2 class="text-center fistactive">Wi-Fi Log in</h2>
			<form class="vertical-form d-flex flex-column align-item-center flex-column" name="login"
				action="http://log.in/login" method="post" background="#A03472"  onSubmit="return doLogin()"
				>
				<input type="hidden" name="dst" value="http://192.168.4.1/api/status" />
				<input type="hidden" name="popup" value="true" />
				<div class="position-relative">
					<span class="starting-Icon"><i class="fas fa-at"></i></span>
					<input type="text" name="username" id="username" placeholder="Username">
				</div>
				<div class="position-relative">
					<span class="starting-Icon"><i class="fa-solid fa-lock"></i></span>
					<input type="password" name="password" id="password" placeholder="Password">
					<span class="showHide-btn"><i class="fa-solid fa-eye"></i></span>
				</div>
				<div id="authFields">
				</div>
				<input name="submit" type="submit" value="LOG IN" class="loginBtn" />
				<div class='footer'>
					<p></p>
					<p></p>
					<br>
				</div>
			</form>
		</div>
		<div class="w-100 d-flex justify-content-center align-item-center overflow-hidden">
			<img class="personImage" src="./assets/Images/Thrive_1.png" alt="Person_Image">
		</div>

	</main>
	<script src="./assets/js/index.js"></script>
</body>

</html>

